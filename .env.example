# ---------------------------------------------------------------------------
# Copy to `.env` in the repository root:  cp .env.example .env
# Both the API (server/) and the Vite dev server (client/) read this file.
# Never commit the real `.env`.
# ---------------------------------------------------------------------------

# ----- API server -----
# NODE_ENV is deliberately NOT set here: Vite also reads this file, and NODE_ENV=development
# would make `vite build` produce a (much larger) development bundle. The API defaults to
# development; Docker Compose sets NODE_ENV=production for containers.
PORT=5000
# Leave MONGO_URI empty in development to use a throw-away in-memory MongoDB.
# The value below targets the Docker Compose mongo (start it with: docker compose up -d mongo).
# directConnection=true is required from the host because the replica set advertises
# the Docker-internal hostname "mongo".
MONGO_URI=mongodb://localhost:27017/expression_detector?directConnection=true
# Host port for the Docker Compose mongo (change it if a local MongoDB already uses 27017).
MONGO_HOST_PORT=27017
# Comma-separated list of browser origins allowed by CORS.
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# Auth — use long random values (e.g. `openssl rand -hex 32`). Required in production.
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Rate limiting (per client IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
EMAIL_RATE_LIMIT_MAX=5
# Optional: share rate-limit counters between API instances (empty = per-instance memory).
# Docker Compose sets redis://redis:6379 for the API containers.
REDIS_URL=

# Number of reverse proxies in front of the API (1 when behind Nginx, 0 locally).
TRUST_PROXY_HOPS=0

# ----- Email (verification + password reset) -----
# Public URL of the web app, used to build links in emails.
APP_URL=http://localhost:5173
# Empty SMTP_HOST in development = emails (with their links) are printed in the API log.
# Docker Compose uses Mailpit (inbox at http://localhost:8025).
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Expression Detector <no-reply@localhost>

# ----- Data retention -----
# Anonymous detections are deleted automatically after this many days (0 = keep forever).
# Signed-in users choose their own retention on the Account page.
ANONYMOUS_RETENTION_DAYS=30

# ----- Tracing (optional) -----
# OpenTelemetry OTLP endpoint, e.g. http://jaeger:4318 with the Compose "observability" profile.
# Empty = tracing off (no overhead).
OTEL_EXPORTER_OTLP_ENDPOINT=

# ----- Browser client (must start with VITE_; these are PUBLIC, never put secrets here) -----
# How often a continuing expression is flushed to the API while auto-save is on.
VITE_PERSIST_MAX_SEGMENT_MS=60000
# Ignore expression segments shorter than this when auto-saving.
VITE_PERSIST_MIN_SEGMENT_MS=2000
